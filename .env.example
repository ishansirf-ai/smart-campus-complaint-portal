PORT=5000

MONGODB_URI=mongodb+srv://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@YOUR_REAL_CLUSTER.mongodb.net/smart_college_portal?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters_long

CLIENT_URL=http://localhost:5000

ADMIN_NAME=Portal Administrator
ADMIN_EMAIL=admin@yourcollege.edu
ADMIN_PASSWORD=choose_a_unique_admin_password_here

# Gmail SMTP (use a Gmail app password, never your normal Gmail password)
GMAIL_USER=your.portal.gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_gmail_app_password
MAIL_FROM_NAME=BGMIT Mudhol - Biluru Gurubasava Mahaswamiji Institute of Technology

# Free Render services cannot send to Gmail SMTP ports. For a public Render
# deployment, use Brevo's HTTPS email API instead of SMTP. Register and verify
# the sender email in Brevo, then add these values only to .env/Render, never
# to frontend code or GitHub.
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=your_brevo_api_key
# BREVO_SENDER_EMAIL=your.verified.sender@gmail.com
# BREVO_SENDER_NAME=BGMIT Mudhol

# Time before the same account can request another email. 30 seconds is the
# secure default; use a number of 20 seconds or more.
OTP_RESEND_COOLDOWN_SECONDS=30

# Compatibility SMTP variables. Gmail values above are preferred.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.portal.gmail@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password
SMTP_FROM="BGMIT Mudhol - Biluru Gurubasava Mahaswamiji Institute of Technology <your.portal.gmail@gmail.com>"

# One separate department account for each fixed department code.
CSE_EMAIL=cse.department@yourcollege.edu
CSE_PASSWORD=choose_a_unique_cse_password_here

AIML_EMAIL=aiml.department@yourcollege.edu
AIML_PASSWORD=choose_a_unique_aiml_password_here

CIVIL_EMAIL=civil.department@yourcollege.edu
CIVIL_PASSWORD=choose_a_unique_civil_password_here

EC_EMAIL=ec.department@yourcollege.edu
EC_PASSWORD=choose_a_unique_ec_password_here

MECHANICAL_EMAIL=mechanical.department@yourcollege.edu
MECHANICAL_PASSWORD=choose_a_unique_mechanical_password_here
